{
  "name": "pg-hybrid-rrf",
  "version": "0.1.0",
  "description": "Hybrid search on Postgres (pgvector + full-text) fused by Reciprocal Rank Fusion, because adding a bounded cosine score to an unbounded ts_rank_cd does not do what the weights say.",
  "keywords": [
    "postgres",
    "pgvector",
    "hybrid-search",
    "rrf",
    "reciprocal-rank-fusion",
    "full-text-search",
    "rag",
    "retrieval",
    "vector-search",
    "tsvector",
    "ranking"
  ],
  "license": "MIT",
  "author": "Bruce Mong-The",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceMong/pg-hybrid-rrf.git"
  },
  "bugs": {
    "url": "https://github.com/BruceMong/pg-hybrid-rrf/issues"
  },
  "homepage": "https://github.com/BruceMong/pg-hybrid-rrf#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
